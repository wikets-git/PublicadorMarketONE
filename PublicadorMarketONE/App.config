<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/>
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!-- BOLDocumentoNET20 (boletas), BOLFolios, BOLLibro y DTELibro* fueron compilados con Liquid 12.2.7.5382;
           en Lib está 12.2.8.5459 (la que usan DTEDocumentoNET20 y DTEBOXClienteNET20). -->
      <dependentAssembly>
        <assemblyIdentity name="LiquidTechnologies.Runtime.Net20" publicKeyToken="64bee40f6e1c14f0" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-12.2.8.5459" newVersion="12.2.8.5459" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
